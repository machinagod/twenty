# Twenty on Railway — environment template (our branch)
# Copy these into each Railway service's Variables. Values marked (shared) must be
# identical across the server and worker services.

# --- Core (shared, required) ---------------------------------------------------
# Railway Postgres plugin exposes DATABASE_URL; Twenty expects PG_DATABASE_URL.
# Set PG_DATABASE_URL to a reference: ${{Postgres.DATABASE_URL}}
PG_DATABASE_URL=postgres://user:password@host:5432/railway
# Railway Redis plugin: reference ${{Redis.REDIS_URL}}
REDIS_URL=redis://default:password@host:6379
# Public URL of the server service (Railway-provided domain or your custom domain)
SERVER_URL=https://your-app.up.railway.app
# Long random string, identical on server + worker. Generate: openssl rand -base64 32
APP_SECRET=replace_me_with_a_long_random_string

# --- Storage -------------------------------------------------------------------
# LOCAL needs a persistent volume mounted at the server's .local-storage.
# For production prefer S3 (set STORAGE_TYPE=s3 and the STORAGE_S3_* vars).
STORAGE_TYPE=local

# --- Telemetry (upstream default is true; REQUIRED here to keep it off) --------
# Disables signup events to twenty-telemetry.com. Set on both services.
TELEMETRY_ENABLED=false

# --- Record-level locking (our feature) ---------------------------------------
# Rules are edited in Settings > Roles (stored in core.recordScopingRule). The old
# RECORD_SCOPING_RULES variable was imported once by the 2.45 upgrade and is no
# longer read. See packages/twenty-server/docs/RECORD_SCOPING.md.

# --- Boot upgrade (entrypoint.sh) ----------------------------------------------
# A failed upgrade stops the container so a half-migrated DB never goes live.
# Migrations run with their own query timeout (default 3600000 ms); runtime
# queries keep PG_DATABASE_PRIMARY_TIMEOUT_MS. A boot upgrade that long only
# survives Railway's health check in the deploy workflow's `upgrade` mode.
# Only override in an emergency:
# UPGRADE_CONTINUE_ON_ERROR=true
# UPGRADE_PG_DATABASE_TIMEOUT_MS=3600000

# --- Server service only --------------------------------------------------------
# Railway sets PORT; Twenty reads NODE_PORT. Reference: ${{PORT}}
NODE_PORT=3000

# --- Worker service only --------------------------------------------------------
# The worker must NOT run migrations/cron (the server already does).
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true
# Since v2.45 the worker runs out of heap at boot under a 1GB memory limit with
# Node's default heap size:
# NODE_OPTIONS=--max-old-space-size=850
